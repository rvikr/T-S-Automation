OPENAI_API_KEY=
SENTINEL_SPECIALIST_MODEL=gpt-4o-mini
SENTINEL_SENIOR_MODEL=gpt-4o
SENTINEL_PRODUCTION_MODEL=gpt-4o-mini
SENTINEL_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
SENTINEL_EMBED_MODEL=text-embedding-3-small
SENTINEL_DB_PATH=sentinel/db/audit.sqlite
# Custom policy taxonomy (YAML or JSON); unset = built-in reference taxonomy.
# See sentinel/policy/policy.example.yaml for the schema.
SENTINEL_POLICY_FILE=
SENTINEL_ADMIN_TOKEN=
# Streamlit UI protection for the paid live-agent tab.
# Set a password before deploying the UI publicly; unset = open (local dev only).
SENTINEL_UI_PASSWORD=
# Per-session cap on live (paid) moderation runs; 0 = unlimited, default 25.
SENTINEL_UI_MAX_LIVE_RUNS=
# API rate limits per client IP per minute (0 disables). Admin routes use the
# stricter bucket; multi-worker deployments still need a gateway limiter.
SENTINEL_RATE_LIMIT_PER_MINUTE=
SENTINEL_ADMIN_RATE_LIMIT_PER_MINUTE=
# Error tracking (optional): install sentry-sdk and set the DSN to enable.
SENTRY_DSN=
# Verdict webhooks (optional): comma-separated hostnames the API may POST
# results to. Unset = webhook delivery disabled (SSRF guard, fails closed).
SENTINEL_WEBHOOK_ALLOWED_HOSTS=
# When set, deliveries carry X-Sentinel-Signature: sha256=<hmac of body>.
SENTINEL_WEBHOOK_SECRET=
# Set to 1 to reuse allow verdicts for byte-identical production uploads
# (only allow verdicts are cached; enforcement and escalation always re-run;
# entries are invalidated automatically when the policy taxonomy changes).
SENTINEL_VERDICT_CACHE=
# Hard ceiling on moderation runs accepted per UTC day across the API and UI
# combined (0 = disabled). The per-session UI cap is a soft brake; this is
# the spend ceiling.
SENTINEL_DAILY_LIVE_RUN_LIMIT=
# Extra webhook delivery attempts after the first, for transient failures
# (network errors, 5xx, 429). Default 2.
SENTINEL_WEBHOOK_RETRIES=
# Jira Cloud escalation (optional; falls back to local ticketing when unset)
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=
